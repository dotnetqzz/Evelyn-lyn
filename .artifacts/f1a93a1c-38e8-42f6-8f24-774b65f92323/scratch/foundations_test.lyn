# 1. Struct Test
struct Point { x, y }
let p = Point(10, 20)
print("Point x: " + p.x)
print("Point y: " + p.y)

# 2. Enum Test
enum Shape {
    Circle(radius),
    Rect(w, h)
}

let c = Shape.Circle(5)
let r = Shape.Rect(10, 20)

# 3. Match Test
def area(s) {
    match s {
        Shape.Circle(r) => { return 3.14 * r * r }
        Shape.Rect(w, h) => { return w * h }
        _ => { return 0 }
    }
}

print("Circle area: " + area(c))
print("Rect area: " + area(r))

# 4. Typed Error Test
struct MyError { msg }

try {
    throw MyError("Something went wrong")
} catch MyError as e {
    print("Caught MyError: " + e.msg)
} catch _err {
    print("Caught generic error")
}
