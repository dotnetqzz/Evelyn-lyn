# Test error code dispatching in catch block
fn makeError(code, msg):
    return {"code": code, "msg": msg}

fn doAction(action):
    if action == "unauth":
        throw makeError(401, "Unauthorized")
    if action == "forbidden":
        throw makeError(403, "Forbidden")
    return "OK"

var handled_code = 0
try {
    doAction("unauth")
} catch e {
    handled_code = e["code"]
}
assert handled_code == 401, "custom error code dispatch failed"
print("PASS: test_err_custom_error_codes")
