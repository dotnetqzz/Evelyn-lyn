# Test Insertion Sort algorithm
fn insertionSort(arr):
    var a = arrayCopy(arr)
    for i in 1..arrayLen(a):
        let key = a[i]
        var j = i - 1
        while j >= 0 and a[j] > key:
            a[j + 1] = a[j]
            j -= 1
        a[j + 1] = key
    return a

let data = [12, 11, 13, 5, 6]
let res = insertionSort(data)
assert res == [5, 6, 11, 12, 13], "insertionSort failed"
print("PASS: test_algo_insertionsort")
