# Test detailed number range classification
fn scoreBracket(pts):
    match pts {
        case 0...49: return "fail"
        case 50...64: return "pass"
        case 65...79: return "merit"
        case 80...100: return "distinction"
        default: return "invalid"
    }

assert scoreBracket(30) == "fail", "score fail failed"
assert scoreBracket(55) == "pass", "score pass failed"
assert scoreBracket(70) == "merit", "score merit failed"
assert scoreBracket(85) == "distinction", "score distinction failed"
print("PASS: test_match_number_ranges_comprehensive")
