# Test secrets module features
import "init"

# 1. Test token_bytes
let b16 = secrets["token_bytes"](16)
assert(stringLen(b16) == 32, "token_bytes generates secure hex-string bytes representation")

# 2. Test token_hex
let hex32 = secrets["token_hex"](16)
assert(stringLen(hex32) == 32, "token_hex generates proper length hex string")

# 3. Test token_urlsafe
let safe = secrets["token_urlsafe"](24)
assert(stringLen(safe) > 20, "token_urlsafe generates proper base64 safe string")
assert(stringContains(safe, "+") == false, "token_urlsafe should not contain plus")
assert(stringContains(safe, "/") == false, "token_urlsafe should not contain slash")
assert(stringContains(safe, "=") == false, "token_urlsafe should not contain equal")

# 4. Test secrets choice
let chosen = secrets["choice"]([10, 20, 30])
assert(chosen == 10 || chosen == 20 || chosen == 30, "secrets choice works")

print("PASS: stdlib secrets support")
