# Test bitwise operator tokens
let a = 0b1010
let b = 0b1100
assert (a & b) == 0b1000, "& operator failed"
assert (a | b) == 0b1110, "| operator failed"
assert (a ^ b) == 0b0110, "^ operator failed"
assert (a << 2) == 0b101000, "<< operator failed"
assert (b >> 2) == 0b0011, ">> operator failed"
print("PASS: test_lex_bitwise_tokens")
