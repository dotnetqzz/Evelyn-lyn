# Test Greedy Graph Coloring algorithm
fn greedyColoring(graph, num_nodes):
    var result = {}
    for i in 0..num_nodes: result[toString(i)] = -1
    result["0"] = 0

    var available = {}
    for i in 0..num_nodes: available[toString(i)] = true

    for u in 1..num_nodes:
        let neighbors = graph[toString(u)] ?? []
        for v in neighbors:
            let col = result[toString(v)]
            if col != -1:
                available[toString(col)] = false

        var cr = 0
        while cr < num_nodes:
            if available[toString(cr)] == true:
                break
            cr += 1

        result[toString(u)] = cr
        for i in 0..num_nodes: available[toString(i)] = true
    return result

let graph = {"0": [1, 2], "1": [0, 2], "2": [0, 1, 3], "3": [2]}
let colors = greedyColoring(graph, 4)
assert colors["0"] != colors["1"], "adjacent colors diff 0-1 failed"
assert colors["1"] != colors["2"], "adjacent colors diff 1-2 failed"
assert colors["0"] != colors["2"], "adjacent colors diff 0-2 failed"
print("PASS: test_algo_graph_coloring_greedy")
