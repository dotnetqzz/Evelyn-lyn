# Test exact binary search algorithm
fn bsearch(arr, val):
    var l = 0
    var r = arrayLen(arr) - 1
    while l <= r:
        let m = (l + r) // 2
        if arr[m] == val:
            return m
        elif arr[m] < val:
            l = m + 1
        else:
            r = m - 1
    return -1

let arr = [10, 20, 30, 40, 50, 60, 70, 80]
assert bsearch(arr, 10) == 0, "bsearch first failed"
assert bsearch(arr, 50) == 4, "bsearch middle failed"
assert bsearch(arr, 80) == 7, "bsearch last failed"
assert bsearch(arr, 99) == -1, "bsearch absent failed"
print("PASS: test_algo_binary_search_exact")
