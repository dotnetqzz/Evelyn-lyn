# Test Result type pattern (ok / err map)
fn safeSqrt(x):
    if x < 0:
        return {"ok": false, "error": "cannot sqrt negative"}
    return {"ok": true, "value": mathSqrt(x)}

let r1 = safeSqrt(144)
assert r1["ok"] == true and r1["value"] == 12.0, "safeSqrt valid failed"

let r2 = safeSqrt(-9)
assert r2["ok"] == false and r2["error"] == "cannot sqrt negative", "safeSqrt negative failed"
print("PASS: test_err_result_type_pattern")
