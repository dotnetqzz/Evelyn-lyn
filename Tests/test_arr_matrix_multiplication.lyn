# Test 2x2 matrix multiplication
let A = [[1, 2], [3, 4]]
let B = [[2, 0], [1, 2]]

var C = [
    [A[0][0]*B[0][0] + A[0][1]*B[1][0], A[0][0]*B[0][1] + A[0][1]*B[1][1]],
    [A[1][0]*B[0][0] + A[1][0]*B[1][0], A[1][0]*B[0][1] + A[1][1]*B[1][1]]
]
assert C[0] == [4, 4], "matrix mul row 0 failed"
print("PASS: test_arr_matrix_multiplication")
