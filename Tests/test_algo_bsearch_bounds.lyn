# Test binary search lower_bound and upper_bound
fn lowerBound(arr, target):
    var low = 0
    var high = arrayLen(arr)
    while low < high:
        let mid = (low + high) // 2
        if arr[mid] < target: low = mid + 1
        else: high = mid
    return low

let data = [1, 2, 4, 4, 4, 5, 7, 9]
assert lowerBound(data, 4) == 2, "lower_bound 4 failed"
assert lowerBound(data, 6) == 6, "lower_bound 6 failed"
print("PASS: test_algo_bsearch_bounds")
