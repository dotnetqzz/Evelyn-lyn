# Test nested for ranges generating table
var matrix = []
for r in 1...3:
    var row = []
    for c in 1...3:
        row = arrayAppend(row, r * c)
    matrix = arrayAppend(matrix, row)

assert matrix[0] == [1, 2, 3], "table row 0 failed"
assert matrix[1] == [2, 4, 6], "table row 1 failed"
assert matrix[2] == [3, 6, 9], "table row 2 failed"
print("PASS: test_ctrl_for_range_nested")
