# Test Run Length Encoding (RLE)
fn rleEncode(s):
    if stringLen(s) == 0: return ""
    var out = ""
    var count = 1
    for i in 1..stringLen(s):
        let curr = stringSub(s, i, 1)
        let prev = stringSub(s, i - 1, 1)
        if curr == prev:
            count += 1
        else:
            out = out + toString(count) + prev
            count = 1
    out = out + toString(count) + stringSub(s, stringLen(s) - 1, 1)
    return out

assert rleEncode("AAABBBCCDAA") == "3A3B2C1D2A", "rle encode failed"
print("PASS: test_algo_run_length_encoding")
