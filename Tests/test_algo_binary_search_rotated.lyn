# Test Binary Search in Rotated Sorted Array
fn searchRotated(nums, target):
    var low = 0
    var high = arrayLen(nums) - 1
    while low <= high:
        let mid = (low + high) // 2
        if nums[mid] == target:
            return mid
        if nums[low] <= nums[mid]:
            if nums[low] <= target and target < nums[mid]:
                high = mid - 1
            else:
                low = mid + 1
        else:
            if nums[mid] < target and target <= nums[high]:
                low = mid + 1
            else:
                high = mid - 1
    return -1

let arr = [4, 5, 6, 7, 0, 1, 2]
assert searchRotated(arr, 0) == 4, "search rotated found 0 failed"
assert searchRotated(arr, 3) == -1, "search rotated absent failed"
print("PASS: test_algo_binary_search_rotated")
