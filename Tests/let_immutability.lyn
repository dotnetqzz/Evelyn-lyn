# Let immutability enforcement
let x = 10
var caught = false

try {
    x = 99
    print("FAIL: should have thrown")
} catch err {
    caught = true
    print("PASS: immutable let caught: " + err)
}

assert(caught, "ImmutabilityError should have been caught")
assert(x == 10, "x should still be 10")
print("PASS: let immutability")
