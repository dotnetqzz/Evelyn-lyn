# Test Insertion Sort algorithm
fn insertionSort(arr):
    var a = deepCopy(arr)
    for i in 1..arrayLen(a):
        let key = a[i]
        var j = i - 1
        while j >= 0 and a[j] > key:
            a[j + 1] = a[j]
            j -= 1
        a[j + 1] = key
    return a

let nums = [12, 11, 13, 5, 6]
assert insertionSort(nums) == [5, 6, 11, 12, 13], "insertion sort failed"
print("PASS: test_algo_insertion_sort")
