# Test floating point literal tokenization
let f0 = 0.0
let f1 = 1.5
let f2 = 3.14159
let f3 = 100.001
assert f0 == 0.0, "float 0.0 failed"
assert f1 == 1.5, "float 1.5 failed"
assert f2 > 3.14 and f2 < 3.15, "float 3.14159 failed"
assert f3 > 100.0 and f3 < 100.01, "float 100.001 failed"
print("PASS: test_lex_float_basic")
