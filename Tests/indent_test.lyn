# Test Python-style indentation syntax

# 1. Basic if/else with indentation
var x = 10
if x > 5:
    print("x is big")
else:
    print("x is small")

# 2. While loop with indentation
var i = 0
while i < 3:
    print(i)
    i += 1

# 3. Function with indentation
def add(a, b):
    return a + b

let result = add(3, 4)
assert(result == 7, "indented def works")

# 4. Nested if inside function
def classify(n):
    if n > 0:
        return "positive"
    else:
        return "non-positive"

assert(classify(5) == "positive", "nested indented if works")
assert(classify(-1) == "non-positive", "nested indented else works")

# 5. For loop
var total = 0
for n in 1..5:
    total += n

assert(total == 10, "indented for loop works")

# 6. Mixed: brace style still works
def square(n) {
    return n * n
}
assert(square(4) == 16, "brace style still works")

# 7. Try/catch with indentation
try:
    throw "oops"
catch e:
    assert(e == "oops", "indented try/catch works")

print("PASS: indentation tests")
