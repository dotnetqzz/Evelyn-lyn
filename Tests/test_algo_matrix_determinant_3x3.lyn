# Test 3x3 matrix determinant calculation
fn det3x3(m):
    let a = m[0][0] * (m[1][1] * m[2][2] - m[1][2] * m[2][1])
    let b = m[0][1] * (m[1][0] * m[2][2] - m[1][2] * m[2][0])
    let c = m[0][2] * (m[1][0] * m[2][1] - m[1][1] * m[2][0])
    return a - b + c

let m = [
    [6, 1, 1],
    [4, -2, 5],
    [2, 8, 7]
]
assert det3x3(m) == -306, "det 3x3 failed"
print("PASS: test_algo_matrix_determinant_3x3")
