print("Phase 6: Deep call value pipelining")
def runPipelineA(a, b) {
    let res = a + b
    return res
}
def runPipelineB(a, b) {
    let res = runPipelineA(a, b) * 2
    return res
}
def runPipelineC(a, b) {
    let res = runPipelineB(a, b) * 3
    return res
}
def runPipelineD(a, b) {
    let res = runPipelineC(a, b) * 4
    return res
}
let pipeFinal = runPipelineD(10, 5)
print(pipeFinal)

