let globalA = 100
let globalB = 200
let globalC = 300
let masterLedger = [1.0, 2.0, 3.0]

def verifyCoreMath(x, y) {
    let s1 = mathSqrt(x)
    let p1 = mathPow(s1, 3)
    let a1 = mathAbs(p1)
    let f1 = mathFloor(a1)
    let c1 = mathCeil(f1)
    let r1 = mathRound(c1)
    return r1
}

def deepStackA(d, v) {
    if d < 1 { return sha256(v) }
    let nextD = d - 1
    let localM = v * 1.01
    let res = deepStackA(nextD, localM)
    return stringSub(stringConcat(res, "-a"), 0, 10)
}

def deepStackB(d, v) {
    if d < 1 { return sha256(v) }
    let nextD = d - 1
    let localM = v * 1.02
    let res = deepStackB(nextD, localM)
    return stringSub(stringConcat(res, "-b"), 0, 10)
}

def deepStackC(d, v) {
    if d < 1 { return sha256(v) }
    let nextD = d - 1
    let localM = v * 1.03
    let res = deepStackC(nextD, localM)
    return stringSub(stringConcat(res, "-c"), 0, 10)
}

def deepStackD(d, v) {
    if d < 1 { return sha256(v) }
    let nextD = d - 1
    let localM = v * 1.04
    let res = deepStackD(nextD, localM)
    return stringSub(stringConcat(res, "-d"), 0, 10)
}

