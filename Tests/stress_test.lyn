print("Testing recursive functions...")
def runFactorialCompute(n) {
    if n < 2 {
        return 1
    }
    let subValue = n - 1
    let recursiveResult = runFactorialCompute(subValue)
    return n * recursiveResult
}

let factorialOutput = runFactorialCompute(5)
print("Deep Stack Return Evaluation:")
print(factorialOutput)

