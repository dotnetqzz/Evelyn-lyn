# Isolated test for achilles classification
import "init"

# --- HELPER FUNCTIONS ---
def get_digits(n) {
    let s = toString(n)
    let chars = stringSplit(s, "")
    var out = []
    for c in chars {
        let digitVal = toNumber(c)
        if isNumber(digitVal) {
            let updated = arrayAppend(out, digitVal)
            out = updated
        }
    }
    return out
}

def sum_digits(n) {
    var total = 0
    for d in get_digits(n) { total = total + d }
    return total
}

def is_perfect_square(n) {
    if n < 0 { return false }
    let s = mathRound(mathSqrt(n))
    return s * s == n
}

def is_perfect_cube(n) {
    if n < 0 {
        let absVal = -n
        let c = mathRound(mathPow(absVal, 1.0 / 3.0))
        return c * c * c == absVal
    }
    let c = mathRound(mathPow(n, 1.0 / 3.0))
    return c * c * c == n
}

def proper_divisors_sum(n) {
    if n <= 1 { return 0 }
    var total = 0
    var i = 1
    while i < n {
        if n % i == 0 { total = total + i }
        i = i + 1
    }
    return total
}

def get_prime_factors(n) {
    var temp = n
    var factors = []
    var d = 2
    while d * d <= temp {
        while temp % d == 0 {
            let updated = arrayAppend(factors, d)
            factors = updated
            temp = temp // d
        }
        d = d + 1
    }
    if temp > 1 {
        let updated = arrayAppend(factors, temp)
        factors = updated
    }
    return factors
}

# --- TEST ---
def is_achilles(n) { if not is_perfect_square(n) { let factors = get_prime_factors(n); let uniqueFactors = array["unique"](factors); for p in uniqueFactors { if n % (p * p) != 0 { return false } }; var base = 2; while base * base <= n { var val = base; while val < n { val = val * base }; if val == n { return false }; base = base + 1 }; return true }; return false }
assert(is_achilles(72) == true, "72 is achilles")

print("PASS: achilles classification")
