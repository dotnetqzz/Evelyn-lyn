# Test Kruskal's Minimum Spanning Tree algorithm
fn find(parent, i):
    let k = toString(i)
    if parent[k] == i: return i
    return find(parent, parent[k])

fn unionSets(parent, x, y):
    let xroot = find(parent, x)
    let yroot = find(parent, y)
    parent[toString(xroot)] = yroot

fn mstKruskal(edges, num_nodes):
    var parent = {}
    for i in 0..num_nodes: parent[toString(i)] = i
    var mst_weight = 0
    var edges_count = 0

    for edge in edges:
        let u = edge[0]
        let v = edge[1]
        let w = edge[2]
        let x = find(parent, u)
        let y = find(parent, v)
        if x != y:
            mst_weight += w
            edges_count += 1
            unionSets(parent, x, y)
    return mst_weight

let sorted_edges = [
    [0, 1, 10],
    [1, 3, 15],
    [2, 3, 4],
    [0, 2, 6],
    [0, 3, 5]
]
let sorted_by_weight = [
    [2, 3, 4],
    [0, 3, 5],
    [0, 2, 6],
    [0, 1, 10],
    [1, 3, 15]
]
let mst_w = mstKruskal(sorted_by_weight, 4)
assert mst_w == 19, "mst kruskal weight failed"
print("PASS: test_algo_min_spanning_tree_kruskal")
