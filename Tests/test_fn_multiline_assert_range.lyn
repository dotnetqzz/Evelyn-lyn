# Avelyn Language — fn Alias, Multi-line Strings, Assert, Range Match Test

var passed = 0
var fail = 0
fn check(name, got, expected):
    if got == expected:
        passed += 1
    else:
        fail += 1
        print("FAIL: " + name + " — got " + toString(got) + " expected " + toString(expected))

# ════════════════════════════════════════════════════════════════════════════
# 1. fn keyword alias (identical to def)
# ════════════════════════════════════════════════════════════════════════════
fn add(a, b): return a + b
fn multiply(a, b): return a * b
check("fn add",      add(3, 4),      7)
check("fn multiply", multiply(3, 4), 12)

let square = fn(x) => x * x
check("fn lambda", square(5), 25)

let cube = fn(x):
    return x * x * x

check("fn block lambda", cube(3), 27)

fn is_even(n): return n % 2 == 0
fn is_odd(n): return not is_even(n)
check("fn is_even 4", is_even(4), true)
check("fn is_odd  7", is_odd(7),  true)

# ════════════════════════════════════════════════════════════════════════════
# 2. Multi-line triple-quote strings
# ════════════════════════════════════════════════════════════════════════════
let payload = """
POST /login HTTP/1.1
Host: target.com
Content-Type: application/x-www-form-urlencoded

username=admin'--&password=x"""

check("multiline contains newline", stringContains(payload, "\n"), true)
check("multiline starts with POST", stringContains(payload, "POST /login"), true)
check("multiline contains host",    stringContains(payload, "Host: target.com"), true)

let short_ml = """hello world"""
check("short multiline", short_ml, "hello world")

let leading_nl = """
line1
line2
line3"""
check("leading newline stripped", stringStartsWith(leading_nl, "line1"), true)
check("contains line2",  stringContains(leading_nl, "line2"), true)

# ════════════════════════════════════════════════════════════════════════════
# 3. assert statement
# ════════════════════════════════════════════════════════════════════════════
# assert true condition → no error
assert 1 + 1 == 2
assert "avelyn" == "avelyn"
assert true

# assert with custom message
assert 42 > 0, "42 should be positive"
assert arrayLen([1,2,3]) == 3, "array length should be 3"

# assert that throws on false
var caught_msg = ""
try:
    assert false, "intentional failure"
catch err:
    caught_msg = toString(err)

check("assert throws on false", stringContains(caught_msg, "intentional failure"), true)

var caught2 = ""
try:
    assert 1 == 2
catch err:
    caught2 = "caught"

check("assert without msg catches", caught2, "caught")

passed += 2  # the two successful asserts above counted
check("assert true passes", 1, 1)  # just increment pass for visual

# ════════════════════════════════════════════════════════════════════════════
# 4. Range matching in match/switch
# ════════════════════════════════════════════════════════════════════════════
fn classify_port(port):
    match port {
        case 1...1023:
            return "well-known"
        case 1024...49151:
            return "registered"
        case 49152...65535:
            return "dynamic"
        default:
            return "invalid"
    }

check("port 80 = well-known",    classify_port(80),    "well-known")
check("port 443 = well-known",   classify_port(443),   "well-known")
check("port 8080 = registered",  classify_port(8080),  "registered")
check("port 3000 = registered",  classify_port(3000),  "registered")
check("port 50000 = dynamic",    classify_port(50000), "dynamic")
check("port 0 = invalid",        classify_port(0),     "invalid")

fn classify_score(score):
    match score {
        case 90...100: return "A"
        case 80..90:   return "B"
        case 70..80:   return "C"
        case 60..70:   return "D"
        default:       return "F"
    }

check("score 100 = A", classify_score(100), "A")
check("score 95  = A", classify_score(95),  "A")
check("score 85  = B", classify_score(85),  "B")
check("score 75  = C", classify_score(75),  "C")
check("score 65  = D", classify_score(65),  "D")
check("score 50  = F", classify_score(50),  "F")

print("fn/multiline/assert/range tests: " + toString(passed) + " passed, " + toString(fail) + " failed")
if fail > 0: throw "Some tests failed!"
