# Test hashMd5 builtin
let hash1 = hashMd5("")
let hash2 = hashMd5("hello")
assert stringLen(hash1) == 32, "md5 empty len failed"
assert stringLen(hash2) == 32, "md5 hello len failed"
assert hash1 != hash2, "md5 diff inputs failed"
assert hashMd5("hello") == hash2, "md5 deterministic failed"
print("PASS: test_std_crypto_md5")
