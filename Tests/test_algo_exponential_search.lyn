# Test Exponential Search on unbounded sorted array
fn expSearch(arr, target):
    let n = arrayLen(arr)
    if n == 0: return -1
    if arr[0] == target: return 0
    var i = 1
    while i < n and arr[i] <= target: i = i * 2
    var low = i // 2
    var high = mathMin(i, n - 1)
    while low <= high:
        let mid = (low + high) // 2
        if arr[mid] == target: return mid
        elif arr[mid] < target: low = mid + 1
        else: high = mid - 1
    return -1

let arr = [2, 3, 4, 10, 40, 55, 70, 90, 120, 200]
assert expSearch(arr, 55) == 5, "exp search found failed"
assert expSearch(arr, 999) == -1, "exp search absent failed"
print("PASS: test_algo_exponential_search")
