# Test switch with 10 distinct integer cases
fn numberName(n):
    switch n {
        case 1: return "one"
        case 2: return "two"
        case 3: return "three"
        case 4: return "four"
        case 5: return "five"
        case 6: return "six"
        case 7: return "seven"
        case 8: return "eight"
        case 9: return "nine"
        case 10: return "ten"
        default: return "other"
    }

assert numberName(7) == "seven", "switch case 7 failed"
assert numberName(10) == "ten", "switch case 10 failed"
assert numberName(99) == "other", "switch default failed"
print("PASS: test_edge_switch_many_cases_10")
