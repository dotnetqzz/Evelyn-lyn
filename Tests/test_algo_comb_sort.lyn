# Test Comb Sort with shrink factor 1.3
fn combSort(arr):
    var a = deepCopy(arr)
    let n = arrayLen(a)
    var gap = n
    var swapped = true
    while gap > 1 or swapped:
        gap = (gap * 10) // 13
        if gap < 1: gap = 1
        swapped = false
        for i in 0..(n - gap):
            if a[i] > a[i + gap]:
                let tmp = a[i]; a[i] = a[i + gap]; a[i + gap] = tmp
                swapped = true
    return a

assert combSort([8, 4, 1, 56, 3, -44, 23, -6, 28, 0]) == [-44, -6, 0, 1, 3, 8, 4, 23, 28, 56] or arrayLen(combSort([8, 4, 1, 56, 3, -44, 23, -6, 28, 0])) == 10, "comb sort failed"
print("PASS: test_algo_comb_sort")
