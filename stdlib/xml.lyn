# Sylvel Standard Library — xml.lyn
# Exposes clean, lightweight XML parsing helper functions

import "re"

def xml_parse_tag_with_attrs(xmlStr, tag) {
    # Match <tag ...>content</tag>
    let pat = "<" + tag + "(?:\\s+[^>]*?)?>(.*?)</" + tag + ">"
    let groups = re["groups"](pat, xmlStr)
    if isNull(groups) or arrayLen(groups) < 2 { return null }
    return groups[1]
}

def xml_parse_attrs(xmlStr, tag) {
    let tagPat = "<" + tag + "(\\s+[^>]*?)?>"
    let groups = re["groups"](tagPat, xmlStr)
    if isNull(groups) or arrayLen(groups) < 2 { return {} }
    let attrStr = groups[1]
    var attrs = {}
    let parts = stringSplit(attrStr, " ")
    for part in parts {
        let trimmed = strip(part)
        if stringContains(trimmed, "=") {
            let kv = stringSplit(trimmed, "=")
            if arrayLen(kv) == 2 {
                let k = strip(kv[0])
                let v = stringReplaceAll(strip(kv[1]), "\"", "")
                mapSet(attrs, k, v)
            }
        }
    }
    return attrs
}

let xml = {
    "findTag":      def(xmlStr, tag) => xml_parse_tag_with_attrs(xmlStr, tag),
    "findAttributes": def(xmlStr, tag) => xml_parse_attrs(xmlStr, tag),
}
