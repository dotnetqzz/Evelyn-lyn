# Sylvel Standard Library — xml.lyn
# Exposes clean, lightweight XML parsing helper functions

import "re"

def xml_parse_tag_with_attrs(xmlStr, tag) {
    let openTag = "<" + tag
    let closeTag = "</" + tag + ">"
    let openIdx = stringIndexOf(xmlStr, openTag)
    if openIdx < 0 { return null }
    let closeIdx = stringIndexOf(xmlStr, closeTag)
    if closeIdx < 0 { return null }
    let restOfStr = stringSub(xmlStr, openIdx, stringLen(xmlStr) - openIdx)
    let afterOpen = stringIndexOf(restOfStr, ">")
    if afterOpen < 0 { return null }
    let contentStart = openIdx + afterOpen + 1
    if contentStart > closeIdx { return null }
    return stringSub(xmlStr, contentStart, closeIdx - contentStart)
}

def xml_parse_attrs(xmlStr, tag) {
    let openTag = "<" + tag
    let openIdx = stringIndexOf(xmlStr, openTag)
    if openIdx < 0 { return {} }
    let restOfStr = stringSub(xmlStr, openIdx, stringLen(xmlStr) - openIdx)
    let tagEnd = stringIndexOf(restOfStr, ">")
    if tagEnd < 0 { return {} }
    let tagHeader = stringSub(xmlStr, openIdx + stringLen(openTag), tagEnd - stringLen(openTag))
    var attrs = {}
    let parts = stringSplit(tagHeader, " ")
    for part in parts {
        let trimmed = strip(part)
        if stringContains(trimmed, "=") {
            let kv = stringSplit(trimmed, "=")
            if arrayLen(kv) == 2 {
                let k = strip(kv[0])
                let v = stringReplaceAll(strip(kv[1]), "\"", "")
                mapSet(attrs, k, v)
            }
        }
    }
    return attrs
}

let xml = {
    "findTag":        def(xmlStr, tag) => xml_parse_tag_with_attrs(xmlStr, tag),
    "findAttributes": def(xmlStr, tag) => xml_parse_attrs(xmlStr, tag),
}
