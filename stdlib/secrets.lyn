# Sylvel Standard Library — secrets.lyn
# Replicates CPython's secrets module using OS-level CSPRNG entropy

import "random"

def secrets_tokenBytes(n) {
    var size = 32
    if not isNull(n) { size = n }
    return hexEncode(sysSecureRandomBytes(size))
}

def secrets_tokenHex(n) {
    var size = 32
    if not isNull(n) { size = n }
    return hexEncode(sysSecureRandomBytes(size))
}

def secrets_tokenUrlsafe(n) {
    var size = 32
    if not isNull(n) { size = n }
    import "base64"
    let hexStr = sysSecureRandomBytes(size)
    let b64 = base64["b64encode"](hexStr)
    var safe = stringReplaceAll(b64, "+", "-")
    safe = stringReplaceAll(safe, "/", "_")
    safe = stringReplaceAll(safe, "=", "")
    return safe
}

let secrets = {
    "token_bytes":   def(n) => secrets_tokenBytes(n),
    "token_hex":     def(n) => secrets_tokenHex(n),
    "token_urlsafe": def(n) => secrets_tokenUrlsafe(n),
    "choice":        def(arr) => random["choice"](arr),
}

