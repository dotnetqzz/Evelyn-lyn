# Avelyn Standard Library: http
# Advanced HTTP requests, pentest fuzzing, and web utilities.

import "string"

let http = {
    "urlEncode": fn(s) => urlEncode(s),
    "urlDecode": fn(s) => urlDecode(s),
    
    "request": fn(opts) => httpRequest(opts),
    
    "get": fn(url, hdrs=null) => httpRequest({"method": "GET", "url": url, "headers": hdrs ?? {}}),
    "post": fn(url, body, hdrs=null) => httpRequest({"method": "POST", "url": url, "body": body, "headers": hdrs ?? {}}),
    
    "dirBrute": fn(url, words, opts) => httpDirBrute(url, words, opts),
    "basicBrute": fn(url, user, words, opts) => httpBasicBrute(url, user, words, opts),

    "cookieJar": fn() {
        var store = {}
        
        let jar = {
            "set": fn(key, val) {
                store[key] = val
            },
            "get": fn(key) {
                return store[key]
            },
            "all": fn() {
                return store
            },
            # Extract Set-Cookie from response headers
            "extract": fn(resp) {
                if arrayLen(mapKeys(resp)) > 0 {
                    let hdrs = resp["headers"]
                    if hdrs != null {
                        let sc = hdrs["Set-Cookie"] ?? hdrs["set-cookie"]
                        if sc != null {
                            let parts = string["split"](sc, ";")
                            if arrayLen(parts) > 0 {
                                let kv = string["split"](parts[0], "=")
                                if arrayLen(kv) == 2 {
                                    store[string["trim"](kv[0])] = string["trim"](kv[1])
                                }
                            }
                        }
                    }
                }
            },
            # Inject cookies into request options
            "inject": fn(opts) {
                var cookieStr = ""
                let keys = mapKeys(store)
                for k in keys {
                    if string["len"](cookieStr) > 0 {
                        cookieStr = cookieStr + "; "
                    }
                    cookieStr = cookieStr + k + "=" + store[k]
                }
                
                if string["len"](cookieStr) > 0 {
                    var hdrs = opts["headers"]
                    if hdrs == null {
                        hdrs = {}
                    }
                    hdrs["Cookie"] = cookieStr
                    opts["headers"] = hdrs
                }
                return opts
            }
        }
        return jar
    }
}
