# Sylvel Standard Library — functional.lyn
# High-level functional programming utilities

var _partial_fn = null
var _partial_preset = []

def fn_partial(func, presetArgs) {
    _partial_fn = func
    _partial_preset = presetArgs
    return def(...args) {
        var merged = arraySlice(_partial_preset, 0, arrayLen(_partial_preset))
        for arg in args {
            merged = arrayAppend(merged, arg)
        }
        let n = arrayLen(merged)
        if n == 0 { return _partial_fn() }
        if n == 1 { return _partial_fn(merged[0]) }
        if n == 2 { return _partial_fn(merged[0], merged[1]) }
        if n == 3 { return _partial_fn(merged[0], merged[1], merged[2]) }
        if n == 4 { return _partial_fn(merged[0], merged[1], merged[2], merged[3]) }
        return _partial_fn(merged[0], merged[1], merged[2], merged[3], merged[4])
    }
}

var _memoize_cache = {}
var _memoize_fn = null

def fn_memoize(func) {
    _memoize_fn = func
    _memoize_cache = {}
    return def(arg) {
        let key = toString(arg)
        if not mapHas(_memoize_cache, key) {
            let res = _memoize_fn(arg)
            mapSet(_memoize_cache, key, res)
        }
        return mapGet(_memoize_cache, key)
    }
}

def fn_pipe(val, fns) {
    var result = val
    for f in fns {
        result = f(result)
    }
    return result
}

var _compose_fns = []

def fn_compose(fns) {
    _compose_fns = fns
    return def(val) {
        var result = val
        var i = arrayLen(_compose_fns) - 1
        while i >= 0 {
            let f = _compose_fns[i]
            result = f(result)
            i -= 1
        }
        return result
    }
}

let functional = {
    "partial": def(func, presetArgs) => fn_partial(func, presetArgs),
    "memoize": def(func)             => fn_memoize(func),
    "pipe":    def(val, fns)         => fn_pipe(val, fns),
    "compose": def(fns)              => fn_compose(fns),
}
