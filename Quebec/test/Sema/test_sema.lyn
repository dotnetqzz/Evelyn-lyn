# Quebec Compiler (Evelyn) — test/Sema/test_sema.lyn

import "../../lib/Parse/Lexer.lyn"
import "../../lib/Parse/Parser.lyn"
import "../../lib/Sema/NameLookup.lyn"
import "../../lib/Basic/DiagnosticEngine.lyn"

def test_sema_pipeline() {
    let source = """
    let pi = 3.14159
    var radius = 5
    def calculate_area(r) {
        return pi * r * r
    }
    """

    let diag = diag_engine_new(true)
    let lex = lexer_new(source, 0)
    let tokens = lexer_tokenize_all(lex)

    let parser = parser_new(tokens)
    let ast = parser_parse_program(parser)

    let nr = name_resolver_new(diag, "test_sema.lyn")
    name_resolve_program(nr, ast)

    print("Semantic analysis finished: " + toString(diag["errors"]) + " error(s), " + toString(diag["warnings"]) + " warning(s)")
}

test_sema_pipeline()
