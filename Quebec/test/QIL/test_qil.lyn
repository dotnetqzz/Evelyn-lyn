# Quebec Compiler (Evelyn) — test/QIL/test_qil.lyn

import "../../lib/Parse/Lexer.lyn"
import "../../lib/Parse/Parser.lyn"
import "../../lib/QILGen/QILGen.lyn"
import "../../lib/QIL/QILPrinter.lyn"

def test_qil_pipeline() {
    let source = """
    def add(a, b) {
        return a + b
    }

    let x = 10
    var y = 20
    while y > 0 {
        y = y - 1
    }
    """

    let lex = lexer_new(source, 0)
    let tokens = lexer_tokenize_all(lex)

    let parser = parser_new(tokens)
    let ast = parser_parse_program(parser)

    let qg = qilgen_new("test_qil_module")
    qilgen_lower_program(qg, ast)

    let qilText = qil_dump_module(qg["module"])
    print("=== Generated QIL ===")
    print(qilText)
}

test_qil_pipeline()
