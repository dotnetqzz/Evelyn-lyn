# Quebec Compiler (Evelyn) — lib/Parse/TokenKinds.lyn
# Token Kind Constants

# Literals & Identifiers
let TOK_EOF           = 0
let TOK_IDENTIFIER    = 1
let TOK_INT_LIT       = 2
let TOK_FLOAT_LIT     = 3
let TOK_STRING_LIT    = 4
let TOK_INTERP_START  = 5
let TOK_INTERP_MID    = 6
let TOK_INTERP_END    = 7
let TOK_BYTEARRAY_LIT = 8

# Keywords
let TOK_KW_LET        = 10
let TOK_KW_VAR        = 11
let TOK_KW_DEF        = 12
let TOK_KW_RETURN     = 13
let TOK_KW_IF         = 14
let TOK_KW_ELSE       = 15
let TOK_KW_WHILE      = 16
let TOK_KW_FOR        = 17
let TOK_KW_IN         = 18
let TOK_KW_BREAK      = 19
let TOK_KW_CONTINUE   = 20
let TOK_KW_PASS       = 21
let TOK_KW_STRUCT     = 22
let TOK_KW_ENUM       = 23
let TOK_KW_MATCH      = 24
let TOK_KW_SWITCH     = 25
let TOK_KW_CASE       = 26
let TOK_KW_DEFAULT    = 27
let TOK_KW_TRY        = 28
let TOK_KW_CATCH      = 29
let TOK_KW_FINALLY    = 30
let TOK_KW_THROW      = 31
let TOK_KW_ASSERT     = 32
let TOK_KW_IMPORT     = 33
let TOK_KW_INCLUDE    = 34
let TOK_KW_EXPORT     = 35
let TOK_KW_PRINT      = 36
let TOK_KW_TIME       = 37
let TOK_KW_TRUE       = 38
let TOK_KW_FALSE      = 39
let TOK_KW_NULL       = 40
let TOK_KW_AND        = 41
let TOK_KW_OR         = 42
let TOK_KW_NOT        = 43

# Operators
let TOK_OP_PLUS       = 50  # +
let TOK_OP_MINUS      = 51  # -
let TOK_OP_STAR       = 52  # *
let TOK_OP_SLASH      = 53  # /
let TOK_OP_SLASHSLASH = 54  # //
let TOK_OP_PERCENT    = 55  # %
let TOK_OP_STARSTAR   = 56  # **
let TOK_OP_AMP        = 57  # &
let TOK_OP_PIPE       = 58  # |
let TOK_OP_CARET      = 59  # ^
let TOK_OP_TILDE      = 60  # ~
let TOK_OP_SHL        = 61  # <<
let TOK_OP_SHR        = 62  # >>
let TOK_OP_EQEQ       = 63  # ==
let TOK_OP_NEQ        = 64  # !=
let TOK_OP_LT         = 65  # <
let TOK_OP_LTE        = 66  # <=
let TOK_OP_GT         = 67  # >
let TOK_OP_GTE        = 68  # >=
let TOK_OP_ASSIGN     = 69  # =
let TOK_OP_PLUSEQ     = 70  # +=
let TOK_OP_MINUSEQ    = 71  # -=
let TOK_OP_STAREQ     = 72  # *=
let TOK_OP_SLASHEQ    = 73  # /=
let TOK_OP_SLASHSLASHEQ = 74# //=
let TOK_OP_PERCENTEQ  = 75  # %=
let TOK_OP_STARSTAREQ = 76  # **=
let TOK_OP_AMPEQ      = 77  # &=
let TOK_OP_PIPEEQ     = 78  # |=
let TOK_OP_CARETEQ    = 79  # ^=
let TOK_OP_SHLEQ      = 80  # <<=
let TOK_OP_SHREQ      = 81  # >>=
let TOK_OP_ARROW      = 82  # ->
let TOK_OP_FATARROW   = 83  # =>
let TOK_OP_QUESTION   = 84  # ?
let TOK_OP_COLON      = 85  # :
let TOK_OP_NULLCOAL   = 86  # ??
let TOK_OP_PIPELINE   = 87  # |>
let TOK_OP_DOT        = 88  # .
let TOK_OP_DOTDOT     = 89  # ..
let TOK_OP_DOTDOTEQ   = 90  # ..=
let TOK_OP_SPREAD     = 91  # ...

# Delimiters
let TOK_DELIM_COMMA   = 100 # ,
let TOK_DELIM_SEMI    = 101 # ;
let TOK_DELIM_LPAREN  = 102 # (
let TOK_DELIM_RPAREN  = 103 # )
let TOK_DELIM_LBRACK  = 104 # [
let TOK_DELIM_RBRACK  = 105 # ]
let TOK_DELIM_LBRACE  = 106 # {
let TOK_DELIM_RBRACE  = 107 # }
let TOK_DELIM_AT      = 108 # @

def get_keyword_kind(buf) {
    if buf == "let" { return TOK_KW_LET }
    if buf == "var" { return TOK_KW_VAR }
    if buf == "def" { return TOK_KW_DEF }
    if buf == "return" { return TOK_KW_RETURN }
    if buf == "if" { return TOK_KW_IF }
    if buf == "else" { return TOK_KW_ELSE }
    if buf == "while" { return TOK_KW_WHILE }
    if buf == "for" { return TOK_KW_FOR }
    if buf == "in" { return TOK_KW_IN }
    if buf == "break" { return TOK_KW_BREAK }
    if buf == "continue" { return TOK_KW_CONTINUE }
    if buf == "pass" { return TOK_KW_PASS }
    if buf == "struct" { return TOK_KW_STRUCT }
    if buf == "enum" { return TOK_KW_ENUM }
    if buf == "match" { return TOK_KW_MATCH }
    if buf == "switch" { return TOK_KW_SWITCH }
    if buf == "case" { return TOK_KW_CASE }
    if buf == "default" { return TOK_KW_DEFAULT }
    if buf == "try" { return TOK_KW_TRY }
    if buf == "catch" { return TOK_KW_CATCH }
    if buf == "finally" { return TOK_KW_FINALLY }
    if buf == "throw" { return TOK_KW_THROW }
    if buf == "assert" { return TOK_KW_ASSERT }
    if buf == "import" { return TOK_KW_IMPORT }
    if buf == "include" { return TOK_KW_INCLUDE }
    if buf == "export" { return TOK_KW_EXPORT }
    if buf == "print" { return TOK_KW_PRINT }
    if buf == "time" { return TOK_KW_TIME }
    if buf == "true" { return TOK_KW_TRUE }
    if buf == "false" { return TOK_KW_FALSE }
    if buf == "null" { return TOK_KW_NULL }
    if buf == "and" { return TOK_KW_AND }
    if buf == "or" { return TOK_KW_OR }
    if buf == "not" { return TOK_KW_NOT }
    return TOK_IDENTIFIER
}
