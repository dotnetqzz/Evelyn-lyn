# Quebec Compiler (Evelyn) — lib/Parse/Token.lyn
# Token data structure and helper methods

import "TokenKinds.lyn"

struct Token {
    kind:   Int,
    text:   String,
    line:   Int,
    col:    Int,
    offset: Int,
    fileId: Int
}

def makeToken(kind, text, line, col, offset, fileId) {
    return {
        "kind":   kind,
        "text":   text,
        "line":   line,
        "col":    col,
        "offset": offset,
        "fileId": fileId
    }
}

def tokenKindName(kind) {
    if kind == TOK_EOF           { return "end of file" }
    if kind == TOK_IDENTIFIER    { return "identifier" }
    if kind == TOK_INT_LIT       { return "integer literal" }
    if kind == TOK_FLOAT_LIT     { return "float literal" }
    if kind == TOK_STRING_LIT    { return "string literal" }
    if kind == TOK_KW_LET        { return "'let'" }
    if kind == TOK_KW_VAR        { return "'var'" }
    if kind == TOK_KW_DEF        { return "'def'" }
    if kind == TOK_KW_RETURN     { return "'return'" }
    if kind == TOK_KW_IF         { return "'if'" }
    if kind == TOK_KW_ELSE       { return "'else'" }
    if kind == TOK_KW_WHILE      { return "'while'" }
    if kind == TOK_KW_FOR        { return "'for'" }
    if kind == TOK_KW_IN         { return "'in'" }
    if kind == TOK_KW_STRUCT     { return "'struct'" }
    if kind == TOK_KW_ENUM       { return "'enum'" }
    if kind == TOK_KW_MATCH      { return "'match'" }
    if kind == TOK_OP_PLUS       { return "'+'" }
    if kind == TOK_OP_MINUS      { return "'-'" }
    if kind == TOK_OP_STAR       { return "'*'" }
    if kind == TOK_OP_SLASH      { return "'/'" }
    if kind == TOK_OP_EQEQ       { return "'=='" }
    if kind == TOK_OP_NEQ        { return "'!='" }
    if kind == TOK_OP_ASSIGN     { return "'='" }
    if kind == TOK_DELIM_LPAREN  { return "'('" }
    if kind == TOK_DELIM_RPAREN  { return "')'" }
    if kind == TOK_DELIM_LBRACE  { return "'{'" }
    if kind == TOK_DELIM_RBRACE  { return "'}'" }
    if kind == TOK_DELIM_COMMA   { return "','" }
    if kind == TOK_DELIM_SEMI    { return "';'" }
    if kind == TOK_DELIM_COLON   { return "':'" }
    return "token(" + toString(kind) + ")"
}
