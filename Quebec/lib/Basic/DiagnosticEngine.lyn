# Quebec Compiler (Evelyn) — lib/Basic/DiagnosticEngine.lyn
# Diagnostic reporting with ANSI color highlights and source caret pointers

def term_format(codeName, text) {
    var code = ""
    if codeName == "bold" { code = "1" }
    else if codeName == "red" { code = "31" }
    else if codeName == "green" { code = "32" }
    else if codeName == "yellow" { code = "33" }
    else if codeName == "blue" { code = "34" }
    else if codeName == "magenta" { code = "35" }
    else if codeName == "cyan" { code = "36" }
    else if codeName == "white" { code = "37" }
    else if codeName == "gray" { code = "90" }

    if stringLen(code) > 0 {
        return "\u001b[" + code + "m" + text + "\u001b[0m"
    }
    return text
}

let DIAG_SEV_ERROR   = 0
let DIAG_SEV_WARNING = 1
let DIAG_SEV_NOTE    = 2

def diag_engine_new(useColors) {
    return {
        "errors":      0,
        "warnings":    0,
        "notes":       0,
        "useColors":   useColors,
        "diagnostics": []
    }
}

def diag_format_header(engine, severity, filePath, line, col, message) {
    var sevStr = "error"
    var sevColor = "red"
    if severity == DIAG_SEV_WARNING {
        sevStr = "warning"
        sevColor = "yellow"
    } else if severity == DIAG_SEV_NOTE {
        sevStr = "note"
        sevColor = "cyan"
    }

    let locPrefix = filePath + ":" + toString(line) + ":" + toString(col) + ": "
    if engine["useColors"] {
        let coloredLoc = term_format("bold", locPrefix)
        let coloredSev = term_format(sevColor, term_format("bold", sevStr + ": "))
        let coloredMsg = term_format("bold", message)
        return coloredLoc + coloredSev + coloredMsg
    }
    return locPrefix + sevStr + ": " + message
}

def diag_emit(engine, severity, filePath, line, col, message, sourceLine) {
    if severity == DIAG_SEV_ERROR {
        mapSet(engine, "errors", engine["errors"] + 1)
    } else if severity == DIAG_SEV_WARNING {
        mapSet(engine, "warnings", engine["warnings"] + 1)
    } else {
        mapSet(engine, "notes", engine["notes"] + 1)
    }

    let header = diag_format_header(engine, severity, filePath, line, col, message)
    print(header)

    if stringLen(sourceLine) > 0 {
        let lineNumStr = toString(line) + " | "
        var paddingLen = col - 1
        if paddingLen < 0 { paddingLen = 0 }
        let padding = " " * paddingLen

        var caretChar = "^"
        let underline = ""
        if engine["useColors"] {
            caretChar = term_format("green", term_format("bold", "^"))
        }

        print(" " + toString(line) + " | " + sourceLine)
        print(" " + (" " * stringLen(toString(line))) + " | " + padding + caretChar)
    }
}

def diag_error(engine, filePath, line, col, message, sourceLine) {
    diag_emit(engine, DIAG_SEV_ERROR, filePath, line, col, message, sourceLine)
}

def diag_warning(engine, filePath, line, col, message, sourceLine) {
    diag_emit(engine, DIAG_SEV_WARNING, filePath, line, col, message, sourceLine)
}

def diag_note(engine, filePath, line, col, message, sourceLine) {
    diag_emit(engine, DIAG_SEV_NOTE, filePath, line, col, message, sourceLine)
}

def diag_has_errors(engine) {
    return engine["errors"] > 0
}
