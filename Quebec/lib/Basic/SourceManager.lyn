# Quebec Compiler (Evelyn) — lib/Basic/SourceManager.lyn
# Source file buffer registry and line tracking

import "io"
import "string"

def src_mgr_new() {
    return {
        "files": [],
        "pathToId": {}
    }
}

def src_mgr_add_file(mgr, path, content) {
    let pathToId = mgr["pathToId"]
    if mapHas(pathToId, path) {
        return mapGet(pathToId, path)
    }

    let fileId = arrayLen(mgr["files"])
    let lines = stringSplit(content, "\n")
    let fileObj = {
        "id":      fileId,
        "path":    path,
        "content": content,
        "lines":   lines
    }

    let updatedFiles = arrayAppend(mgr["files"], fileObj)
    mapSet(mgr, "files", updatedFiles)
    mapSet(pathToId, path, fileId)
    return fileId
}

def src_mgr_load_file(mgr, path) {
    let pathToId = mgr["pathToId"]
    if mapHas(pathToId, path) {
        return mapGet(pathToId, path)
    }

    let content = fileRead(path)
    return src_mgr_add_file(mgr, path, content)
}

def src_mgr_get_file(mgr, fileId) {
    let files = mgr["files"]
    if fileId >= 0 and fileId < arrayLen(files) {
        return files[fileId]
    }
    return null
}

def src_mgr_get_line(mgr, fileId, lineNum) {
    let fileObj = src_mgr_get_file(mgr, fileId)
    if fileObj == null { return "" }
    let lines = fileObj["lines"]
    let idx = lineNum - 1
    if idx >= 0 and idx < arrayLen(lines) {
        let line = lines[idx]
        if stringEndsWith(line, "\r") {
            return stringSub(line, 0, stringLen(line) - 1)
        }
        return line
    }
    return ""
}
