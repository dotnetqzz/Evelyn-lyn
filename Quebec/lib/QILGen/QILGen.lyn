# Quebec Compiler (Evelyn) — lib/QILGen/QILGen.lyn
# Lowering AST to QIL Intermediate Language

import "../AST/ASTNodes.lyn"
import "../QIL/QILModule.lyn"

def qilgen_new(moduleName) {
    let qm = qil_module_new(moduleName)
    return {
        "module":    qm,
        "curFunc":   null,
        "varSlots":  {},
        "constants": {}
    }
}

def qil_func_alloc_slot(qf, prefix) {
    let slot = qil_func_fresh_temp(qf, prefix)
    qil_func_emit(qf, qil_alloc(slot))
    return slot
}

def qilgen_lower_expr(qg, expr) {
    if expr == null { return "null" }
    let kind = expr["kind"]
    let qf = qg["curFunc"]

    if kind == AST_INT_LIT {
        let t = qil_func_alloc_slot(qf, "int_")
        qil_func_emit(qf, qil_runtime_call(t, "sylvel_rt_make_int", [toString(expr["val"])]))
        return "%" + t
    }
    if kind == AST_FLOAT_LIT {
        let t = qil_func_alloc_slot(qf, "flt_")
        qil_func_emit(qf, qil_runtime_call(t, "sylvel_rt_make_float", [toString(expr["val"])]))
        return "%" + t
    }
    if kind == AST_STR_LIT {
        let t = qil_func_alloc_slot(qf, "str_")
        qil_func_emit(qf, qil_runtime_call(t, "sylvel_rt_alloc_string", ["\"" + expr["val"] + "\""]))
        return "%" + t
    }
    if kind == AST_BOOL_LIT {
        let t = qil_func_alloc_slot(qf, "bool_")
        let bVal = expr["val"] ? "1" : "0"
        qil_func_emit(qf, qil_runtime_call(t, "sylvel_rt_make_bool", [bVal]))
        return "%" + t
    }
    if kind == AST_NULL_LIT {
        let t = qil_func_alloc_slot(qf, "null_")
        qil_func_emit(qf, qil_runtime_call(t, "sylvel_rt_make_null", []))
        return "%" + t
    }

    if kind == AST_VAR {
        let varName = expr["name"]
        if mapHas(qg["constants"], varName) {
            let constVal = mapGet(qg["constants"], varName)
            let t = qil_func_alloc_slot(qf, "cst_")
            qil_func_emit(qf, qil_runtime_call(t, "sylvel_rt_make_int", [constVal]))
            return "%" + t
        }
        if mapHas(qg["varSlots"], varName) {
            let slot = mapGet(qg["varSlots"], varName)
            let temp = qil_func_fresh_temp(qf, "v_")
            qil_func_emit(qf, qil_load(temp, slot))
            return "%" + temp
        }
        let temp = qil_func_alloc_slot(qf, "v_undef_")
        return "%" + temp
    }

    if kind == AST_BIN_OP {
        let l = qilgen_lower_expr(qg, expr["left"])
        let r = qilgen_lower_expr(qg, expr["right"])
        let t = qil_func_fresh_temp(qf, "bin_")
        qil_func_emit(qf, qil_binop(t, expr["op"], l, r))
        return "%" + t
    }

    if kind == AST_UNARY_OP {
        let opnd = qilgen_lower_expr(qg, expr["operand"])
        let t = qil_func_fresh_temp(qf, "un_")
        qil_func_emit(qf, qil_unaryop(t, expr["op"], opnd))
        return "%" + t
    }

    if kind == AST_ARRAY_LIT {
        let t = qil_func_fresh_temp(qf, "arr_")
        let elCount = toString(arrayLen(expr["elements"]))
        qil_func_emit(qf, qil_runtime_call(t, "sylvel_rt_alloc_list", [elCount]))
        for el in expr["elements"] {
            let elem = qilgen_lower_expr(qg, el)
            let dummy = qil_func_fresh_temp(qf, "push_")
            qil_func_emit(qf, qil_runtime_call(dummy, "sylvel_rt_list_push", ["%" + t, elem]))
        }
        return "%" + t
    }

    if kind == AST_MAP_LIT {
        let t = qil_func_fresh_temp(qf, "map_")
        let entryCount = toString(arrayLen(expr["entries"]))
        qil_func_emit(qf, qil_runtime_call(t, "sylvel_rt_alloc_map", [entryCount]))
        for entry in expr["entries"] {
            let k = qilgen_lower_expr(qg, entry[0])
            let v = qilgen_lower_expr(qg, entry[1])
            let dummy = qil_func_fresh_temp(qf, "set_")
            qil_func_emit(qf, qil_runtime_call(dummy, "sylvel_rt_map_set", ["%" + t, k, v]))
        }
        return "%" + t
    }

    if kind == AST_SUBSCRIPT {
        let target = qilgen_lower_expr(qg, expr["target"])
        let index = qilgen_lower_expr(qg, expr["index"])
        let t = qil_func_fresh_temp(qf, "sub_")
        qil_func_emit(qf, qil_runtime_call(t, "sylvel_rt_subscript_get", [target, index]))
        return "%" + t
    }

    if kind == AST_CALL_EXPR {
        var argVals = []
        for a in expr["args"] {
            let argVal = qilgen_lower_expr(qg, a)
            argVals = arrayAppend(argVals, argVal)
        }
        let callee = expr["callee"]
        let funcName = (callee["kind"] == AST_VAR) ? callee["name"] : "indirect"
        let t = qil_func_fresh_temp(qf, "call_")
        qil_func_emit(qf, qil_call(t, funcName, argVals))
        return "%" + t
    }

    return "null"
}

def qilgen_lower_stmt(qg, stmt) {
    if stmt == null { return }
    let kind = stmt["kind"]
    let qf = qg["curFunc"]

    if kind == AST_DECL {
        let val = qilgen_lower_expr(qg, stmt["value"])
        let varName = stmt["name"]
        let slot = qil_func_alloc_slot(qf, "slot_" + varName + "_")
        qil_func_emit(qf, qil_store(slot, val))
        mapSet(qg["varSlots"], varName, slot)
        return
    }

    if kind == AST_ASSIGN {
        let val = qilgen_lower_expr(qg, stmt["value"])
        let varName = stmt["name"]
        if mapHas(qg["varSlots"], varName) {
            let slot = mapGet(qg["varSlots"], varName)
            qil_func_emit(qf, qil_store(slot, val))
        }
        return
    }

    if kind == AST_INDEX_ASSIGN {
        let target = qilgen_lower_expr(qg, stmt["target"])
        let index = qilgen_lower_expr(qg, stmt["index"])
        let val = qilgen_lower_expr(qg, stmt["value"])
        let dummy = qil_func_fresh_temp(qf, "sub_set_")
        qil_func_emit(qf, qil_runtime_call(dummy, "sylvel_rt_subscript_set", [target, index, val]))
        return
    }

    if kind == AST_RETURN {
        let retVal = qilgen_lower_expr(qg, stmt["value"])
        qil_func_emit(qf, qil_return(retVal))
        return
    }

    if kind == AST_IF {
        let cond = qilgen_lower_expr(qg, stmt["cond"])
        let thenLabel = qil_func_fresh_temp(qf, "then_")
        let elseLabel = qil_func_fresh_temp(qf, "else_")
        let mergeLabel = qil_func_fresh_temp(qf, "merge_")

        qil_func_emit(qf, qil_cond_branch(cond, thenLabel, elseLabel))

        # Then block
        let thenBB = qil_func_create_block(qf, thenLabel)
        qil_func_set_cur_block(qf, thenBB)
        for s in stmt["then"] { qilgen_lower_stmt(qg, s) }
        qil_func_emit(qf, qil_branch(mergeLabel))

        # Else block
        let elseBB = qil_func_create_block(qf, elseLabel)
        qil_func_set_cur_block(qf, elseBB)
        if stmt["else"] != null {
            for s in stmt["else"] { qilgen_lower_stmt(qg, s) }
        }
        qil_func_emit(qf, qil_branch(mergeLabel))

        # Merge block
        let mergeBB = qil_func_create_block(qf, mergeLabel)
        qil_func_set_cur_block(qf, mergeBB)
        return
    }

    if kind == AST_WHILE {
        let condLabel = qil_func_fresh_temp(qf, "while_cond_")
        let bodyLabel = qil_func_fresh_temp(qf, "while_body_")
        let exitLabel = qil_func_fresh_temp(qf, "while_exit_")

        qil_func_emit(qf, qil_branch(condLabel))

        # Cond block
        let condBB = qil_func_create_block(qf, condLabel)
        qil_func_set_cur_block(qf, condBB)
        let cond = qilgen_lower_expr(qg, stmt["cond"])
        qil_func_emit(qf, qil_cond_branch(cond, bodyLabel, exitLabel))

        # Body block
        let bodyBB = qil_func_create_block(qf, bodyLabel)
        qil_func_set_cur_block(qf, bodyBB)
        for s in stmt["body"] { qilgen_lower_stmt(qg, s) }
        qil_func_emit(qf, qil_branch(condLabel))

        # Exit block
        let exitBB = qil_func_create_block(qf, exitLabel)
        qil_func_set_cur_block(qf, exitBB)
        return
    }

    if kind == AST_FOR {
        let iterVal = qilgen_lower_expr(qg, stmt["iterable"])
        let idxSlot = qil_func_alloc_slot(qf, "slot_for_idx_")
        let zeroTmp = qil_func_alloc_slot(qf, "zero_")
        qil_func_emit(qf, qil_runtime_call(zeroTmp, "sylvel_rt_make_int", ["0"]))
        qil_func_emit(qf, qil_store(idxSlot, "%" + zeroTmp))

        let condLabel = qil_func_fresh_temp(qf, "for_cond_")
        let bodyLabel = qil_func_fresh_temp(qf, "for_body_")
        let exitLabel = qil_func_fresh_temp(qf, "for_exit_")

        qil_func_emit(qf, qil_branch(condLabel))

        # Cond block: idx < arrayLen(iterVal)
        let condBB = qil_func_create_block(qf, condLabel)
        qil_func_set_cur_block(qf, condBB)

        let curIdx = qil_func_fresh_temp(qf, "for_i_")
        qil_func_emit(qf, qil_load(curIdx, idxSlot))

        let lenVal = qil_func_fresh_temp(qf, "for_len_")
        qil_func_emit(qf, qil_call(lenVal, "arrayLen", [iterVal]))

        let cmpVal = qil_func_fresh_temp(qf, "for_cmp_")
        qil_func_emit(qf, qil_binop(cmpVal, "<", "%" + curIdx, "%" + lenVal))
        qil_func_emit(qf, qil_cond_branch("%" + cmpVal, bodyLabel, exitLabel))

        # Body block
        let bodyBB = qil_func_create_block(qf, bodyLabel)
        qil_func_set_cur_block(qf, bodyBB)

        let varName = stmt["varName"]
        let varSlot = qil_func_alloc_slot(qf, "slot_" + varName + "_")
        let itemVal = qil_func_fresh_temp(qf, "for_elem_")
        qil_func_emit(qf, qil_runtime_call(itemVal, "sylvel_rt_subscript_get", [iterVal, "%" + curIdx]))
        qil_func_emit(qf, qil_store(varSlot, "%" + itemVal))
        mapSet(qg["varSlots"], varName, varSlot)

        for s in stmt["body"] { qilgen_lower_stmt(qg, s) }

        # Increment idx
        let curIdxLoad = qil_func_fresh_temp(qf, "for_cur_i_")
        qil_func_emit(qf, qil_load(curIdxLoad, idxSlot))
        let oneTmp = qil_func_alloc_slot(qf, "one_")
        qil_func_emit(qf, qil_runtime_call(oneTmp, "sylvel_rt_make_int", ["1"]))
        let nextIdx = qil_func_fresh_temp(qf, "for_next_i_")
        qil_func_emit(qf, qil_binop(nextIdx, "+", "%" + curIdxLoad, "%" + oneTmp))
        qil_func_emit(qf, qil_store(idxSlot, "%" + nextIdx))
        qil_func_emit(qf, qil_branch(condLabel))

        # Exit block
        let exitBB = qil_func_create_block(qf, exitLabel)
        qil_func_set_cur_block(qf, exitBB)
        return
    }

    # Expression statement
    qilgen_lower_expr(qg, stmt)
}

def qilgen_lower_func(qg, funcDecl) {
    let funcName = funcDecl["name"]
    let params = funcDecl["params"]
    let qf = qil_func_new(funcName, params)
    mapSet(qg, "curFunc", qf)
    mapSet(qg, "varSlots", {})

    # Allocate stack slots for parameters (pass-by-value semantics)
    for p in params {
        let slot = qil_func_alloc_slot(qf, "slot_" + p + "_")
        qil_func_emit(qf, qil_store(slot, "%" + p))
        mapSet(qg["varSlots"], p, slot)
    }

    for stmt in funcDecl["body"] {
        qilgen_lower_stmt(qg, stmt)
    }

    qil_module_add_func(qg["module"], qf)
}

def qilgen_lower_program(qg, ast) {
    # 1. Collect top-level literal constants
    for node in ast {
        if node != null and node["kind"] == AST_DECL {
            let v = node["value"]
            if v != null {
                let vKind = v["kind"]
                if vKind == AST_INT_LIT or vKind == AST_FLOAT_LIT {
                    mapSet(qg["constants"], node["name"], toString(v["val"]))
                } else if vKind == AST_BOOL_LIT {
                    mapSet(qg["constants"], node["name"], v["val"] ? "true" : "false")
                }
            }
        }
    }

    # 2. Lower all functions
    var mainStmts = []
    for node in ast {
        if node["kind"] == AST_FUNC_DECL {
            qilgen_lower_func(qg, node)
        } else {
            mainStmts = arrayAppend(mainStmts, node)
        }
    }

    # 3. Synthesize main function if top-level statements exist
    if arrayLen(mainStmts) > 0 {
        let mainDecl = ast_func_decl("main", [], mainStmts, 1, 1)
        qilgen_lower_func(qg, mainDecl)
    }
}
