# Quebec Compiler (Evelyn) — lib/Sema/NameLookup.lyn
# Symbol resolution and semantic validation

import "Scope.lyn"
import "../AST/ASTNodes.lyn"
import "../Basic/DiagnosticEngine.lyn"

def name_resolver_new(diagEngine, filePath) {
    let globalScope = scope_new(null)
    return {
        "diag":        diagEngine,
        "filePath":    filePath,
        "currentScope": globalScope,
        "loopDepth":   0,
        "funcDepth":   0
    }
}

def name_resolve_expr(nr, node) {
    if node == null { return }
    let kind = node["kind"]

    if kind == AST_VAR {
        let sym = scope_lookup(nr["currentScope"], node["name"])
        if sym == null and not is_runtime_builtin(node["name"]) {
            diag_warning(nr["diag"], nr["filePath"], node["line"], node["col"], "use of undeclared identifier '" + node["name"] + "'", "")
        }
        return
    }

    if kind == AST_BIN_OP {
        name_resolve_expr(nr, node["left"])
        name_resolve_expr(nr, node["right"])
        return
    }

    if kind == AST_UNARY_OP {
        name_resolve_expr(nr, node["operand"])
        return
    }

    if kind == AST_CALL_EXPR {
        name_resolve_expr(nr, node["callee"])
        for arg in node["args"] {
            name_resolve_expr(nr, arg)
        }
        return
    }

    if kind == AST_SUBSCRIPT {
        name_resolve_expr(nr, node["target"])
        name_resolve_expr(nr, node["index"])
        return
    }

    if kind == AST_ARRAY_LIT {
        for elem in node["elements"] {
            name_resolve_expr(nr, elem)
        }
        return
    }

    if kind == AST_MAP_LIT {
        for entry in node["entries"] {
            name_resolve_expr(nr, entry[0])
            name_resolve_expr(nr, entry[1])
        }
        return
    }

    if kind == AST_TERNARY {
        name_resolve_expr(nr, node["cond"])
        name_resolve_expr(nr, node["then"])
        name_resolve_expr(nr, node["else"])
        return
    }
}

def name_resolve_stmt(nr, stmt) {
    if stmt == null { return }
    let kind = stmt["kind"]

    if kind == AST_DECL {
        name_resolve_expr(nr, stmt["value"])
        scope_define(nr["currentScope"], stmt["name"], stmt["mutable"], stmt["line"], stmt["col"])
        return
    }

    if kind == AST_ASSIGN {
        name_resolve_expr(nr, stmt["value"])
        let sym = scope_lookup(nr["currentScope"], stmt["name"])
        if sym != null and not sym["mutable"] {
            diag_error(nr["diag"], nr["filePath"], stmt["line"], stmt["col"], "cannot assign to immutable binding '" + stmt["name"] + "' declared with 'let'", "")
        }
        return
    }

    if kind == AST_FUNC_DECL {
        if stringLen(stmt["name"]) > 0 {
            scope_define(nr["currentScope"], stmt["name"], false, stmt["line"], stmt["col"])
        }

        let funcScope = scope_new(nr["currentScope"])
        mapSet(nr, "currentScope", funcScope)
        mapSet(nr, "funcDepth", nr["funcDepth"] + 1)

        for param in stmt["params"] {
            scope_define(funcScope, param, true, stmt["line"], stmt["col"])
        }

        for bodyStmt in stmt["body"] {
            name_resolve_stmt(nr, bodyStmt)
        }

        mapSet(nr, "funcDepth", nr["funcDepth"] - 1)
        mapSet(nr, "currentScope", funcScope["parent"])
        return
    }

    if kind == AST_WHILE {
        name_resolve_expr(nr, stmt["cond"])
        mapSet(nr, "loopDepth", nr["loopDepth"] + 1)
        let loopScope = scope_new(nr["currentScope"])
        mapSet(nr, "currentScope", loopScope)

        for bodyStmt in stmt["body"] {
            name_resolve_stmt(nr, bodyStmt)
        }

        mapSet(nr, "currentScope", loopScope["parent"])
        mapSet(nr, "loopDepth", nr["loopDepth"] - 1)
        return
    }

    if kind == AST_FOR {
        name_resolve_expr(nr, stmt["iter"])
        mapSet(nr, "loopDepth", nr["loopDepth"] + 1)
        let loopScope = scope_new(nr["currentScope"])
        mapSet(nr, "currentScope", loopScope)
        scope_define(loopScope, stmt["var"], true, stmt["line"], stmt["col"])

        for bodyStmt in stmt["body"] {
            name_resolve_stmt(nr, bodyStmt)
        }

        mapSet(nr, "currentScope", loopScope["parent"])
        mapSet(nr, "loopDepth", nr["loopDepth"] - 1)
        return
    }

    if kind == AST_IF {
        name_resolve_expr(nr, stmt["cond"])
        let thenScope = scope_new(nr["currentScope"])
        mapSet(nr, "currentScope", thenScope)
        for s in stmt["then"] { name_resolve_stmt(nr, s) }
        mapSet(nr, "currentScope", thenScope["parent"])

        if stmt["else"] != null {
            let elseScope = scope_new(nr["currentScope"])
            mapSet(nr, "currentScope", elseScope)
            for s in stmt["else"] { name_resolve_stmt(nr, s) }
            mapSet(nr, "currentScope", elseScope["parent"])
        }
        return
    }

    if kind == AST_RETURN {
        if nr["funcDepth"] <= 0 {
            diag_error(nr["diag"], nr["filePath"], stmt["line"], stmt["col"], "'return' statement outside of function", "")
        }
        name_resolve_expr(nr, stmt["value"])
        return
    }

    if kind == AST_BREAK or kind == AST_CONTINUE {
        if nr["loopDepth"] <= 0 {
            diag_error(nr["diag"], nr["filePath"], stmt["line"], stmt["col"], "'break' / 'continue' outside of loop", "")
        }
        return
    }

    # Expression statement
    name_resolve_expr(nr, stmt)
}

def name_resolve_program(nr, ast) {
    # 1. Forward-declare all functions
    for stmt in ast {
        if stmt != null and stmt["kind"] == AST_FUNC_DECL {
            if stringLen(stmt["name"]) > 0 {
                scope_define(nr["currentScope"], stmt["name"], false, stmt["line"], stmt["col"])
            }
        }
    }

    # 2. Resolve all statements
    for stmt in ast {
        name_resolve_stmt(nr, stmt)
    }
}
