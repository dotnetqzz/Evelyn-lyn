# Quebec Compiler (Evelyn) — lib/IRGen/LLVMIRTextEmitter.lyn
# Emits valid LLVM 15+ textual IR (.ll) from QIL Module

import "../QIL/QILModule.lyn"

def is_digit(ch) {
    return ch >= "0" and ch <= "9"
}

def is_runtime_builtin(name) {
    return name == "print" or name == "println" or name == "toString" or name == "toNumber" or
           name == "stringToNum" or name == "numToString" or name == "charFromCode" or name == "charCodeAt" or
           name == "toBool" or name == "isNumber" or name == "isNull" or name == "isString" or
           name == "isArray" or name == "isMap" or name == "isInteger" or name == "isBool" or
           name == "arrayLen" or name == "stringLen" or name == "len" or name == "arrayAppend" or
           name == "arrayPush" or name == "arrayPop" or name == "arrayIndexOf" or name == "arrayContains" or
           name == "arrayRemove" or name == "arraySlice" or name == "arrayCopy" or name == "arrayReverse" or
           name == "arrayShift" or name == "arraySort" or
           name == "stringSplit" or name == "stringConcat" or name == "stringSub" or name == "stringReverse" or
           name == "stringEndsWith" or name == "stringStartsWith" or name == "stringContains" or
           name == "stringUpper" or name == "stringLower" or name == "stringTrim" or name == "stringReplace" or
           name == "stringAt" or name == "stringIndexOf" or name == "stringJoin" or name == "stringPadStart" or
           name == "stringRepeat" or name == "stringReplaceAll" or name == "stringSplitLines" or
           name == "stringToLower" or name == "stringToUpper" or name == "strip" or
           name == "mapGet" or name == "mapSet" or name == "mapHas" or name == "mapKeys" or
           name == "mapValues" or name == "mapCopy" or name == "deepEqual" or
           name == "fileWrite" or name == "fileRead" or name == "fileAppend" or name == "fileExists" or
           name == "pathJoin" or name == "pathBasename" or name == "pathDirname" or name == "pathExtension" or
           name == "pathAbsolute" or name == "dirCreate" or name == "dirExists" or name == "dirList" or
           name == "dirRemove" or name == "rmTree" or name == "copyTree" or
           name == "sysArgv" or name == "sysPlatform" or name == "sysArch" or name == "sysEnv" or
           name == "sysExecute" or name == "sysExit" or name == "sysReadLine" or name == "sysCopyFile" or
           name == "sysMoveFile" or name == "sysRemoveFile" or name == "jsonParse" or name == "jsonStringify" or
           name == "mathSqrt" or name == "mathRound" or name == "mathPow" or name == "mathAbs" or
           name == "mathFloor" or name == "mathCeil" or name == "mathSin" or name == "mathCos" or
           name == "mathTan" or name == "mathLog" or name == "mathLog2" or name == "mathLog10" or
           name == "mathExp" or name == "mathMin" or name == "mathMax" or
           name == "timeSec" or name == "timeMs" or name == "timeSleep" or name == "random" or
           name == "randint" or name == "choice" or name == "randomBytes" or name == "randomInt" or
           name == "dateFormat" or name == "dateParse" or name == "dateNow" or name == "dateAdd" or
           name == "uuidV4" or name == "base64Encode" or name == "base64Decode" or
           name == "hexEncode" or name == "hexDecode" or name == "sha256" or name == "md5" or
           name == "sha1" or name == "sha512" or name == "hmac" or name == "assert"
}

def llvm_emitter_new(targetTriple, dataLayout) {
    return {
        "targetTriple": targetTriple,
        "dataLayout":   dataLayout,
        "stringTable":  [],
        "stringMap":    {},
        "usedBuiltins": {},
        "tempCounter":  0
    }
}

def llvm_fresh_temp(emitter, prefix) {
    let id = emitter["tempCounter"]
    mapSet(emitter, "tempCounter", id + 1)
    return "%" + prefix + "_" + toString(id)
}

def llvm_intern_string(emitter, strVal) {
    if mapHas(emitter["stringMap"], strVal) {
        return mapGet(emitter["stringMap"], strVal)
    }
    let idx = arrayLen(emitter["stringTable"])
    let sym = "@.str." + toString(idx)
    let updated = arrayAppend(emitter["stringTable"], strVal)
    mapSet(emitter, "stringTable", updated)
    mapSet(emitter, "stringMap", strVal, sym)
    return sym
}

def llvm_emit_runtime_decls(emitter) {
    var out = """
declare void @sylvel_rt_make_null(%SylvelVal*)
declare void @sylvel_rt_make_bool(%SylvelVal*, i32)
declare void @sylvel_rt_make_int(%SylvelVal*, i64)
declare void @sylvel_rt_make_float(%SylvelVal*, double)
declare void @sylvel_rt_alloc_string(%SylvelVal*, i8*)
declare void @sylvel_rt_alloc_list(%SylvelVal*, i64)
declare void @sylvel_rt_alloc_map(%SylvelVal*, i64)
declare void @sylvel_rt_list_push(%SylvelVal*, %SylvelVal*)
declare void @sylvel_rt_map_set(%SylvelVal*, %SylvelVal*, %SylvelVal*)
declare void @sylvel_rt_bin_op(%SylvelVal*, %SylvelVal*, i32, %SylvelVal*)
declare void @sylvel_rt_unary_op(%SylvelVal*, i32, %SylvelVal*)
declare void @sylvel_rt_print(%SylvelVal*)
declare void @sylvel_rt_subscript_get(%SylvelVal*, %SylvelVal*, %SylvelVal*)
declare void @sylvel_rt_subscript_set(%SylvelVal*, %SylvelVal*, %SylvelVal*)
declare void @sylvel_rt_call_builtin(%SylvelVal*, i8*, %SylvelVal*, i32)
declare i1 @sylvel_rt_to_bool(%SylvelVal*)
declare i64 @sylvel_rt_to_int(%SylvelVal*)
declare double @sylvel_rt_to_float(%SylvelVal*)
declare void @sylvel_rt_retain(%SylvelVal*)
declare void @sylvel_rt_release(%SylvelVal*)
"""

    let keys = mapKeys(emitter["usedBuiltins"])
    for bName in keys {
        let arity = mapGet(emitter["usedBuiltins"], bName)
        var decl = "declare void @" + bName + "(%SylvelVal*"
        var j = 0
        while j < arity {
            decl = decl + ", %SylvelVal*"
            j = j + 1
        }
        decl = decl + ")\n"
        out = out + decl
    }

    return out
}

def llvm_escape_char(ch) {
    if ch == "\n" { return "\\0A" }
    if ch == "\r" { return "\\0D" }
    if ch == "\t" { return "\\09" }
    if ch == "\"" { return "\\22" }
    if ch == "\\" { return "\\5C" }
    return ch
}

def llvm_escape_string(strVal) {
    let length = stringLen(strVal)
    var out = ""
    var i = 0
    while i < length {
        let ch = stringSub(strVal, i, 1)
        out = out + llvm_escape_char(ch)
        i = i + 1
    }
    return out
}

def llvm_emit_module(emitter, qilMod) {
    var funcOut = ""
    for func in qilMod["functions"] {
        funcOut = funcOut + llvm_emit_function(emitter, func) + "\n"
    }

    var out = "; ModuleID = '" + qilMod["name"] + "'\n"
    out = out + "target datalayout = \"" + emitter["dataLayout"] + "\"\n"
    out = out + "target triple = \"" + emitter["targetTriple"] + "\"\n\n"
    out = out + "%SylvelVal = type { i32, i32, i64 }\n\n"

    let strCount = arrayLen(emitter["stringTable"])
    var i = 0
    while i < strCount {
        let s = emitter["stringTable"][i]
        let sym = "@.str." + toString(i)
        let sLen = stringLen(s) + 1
        let escaped = llvm_escape_string(s)
        out = out + sym + " = private unnamed_addr constant [" + toString(sLen) + " x i8] c\"" + escaped + "\\00\", align 1\n"
        i = i + 1
    }
    if strCount > 0 { out = out + "\n" }

    out = out + llvm_emit_runtime_decls(emitter) + "\n"
    out = out + funcOut
    return out
}

def llvm_ensure_val_ptr(emitter, val, curOut) {
    var vStr = toString(val)
    if stringStartsWith(vStr, "%") {
        return { "ptr": vStr, "out": curOut }
    }
    let tmp = llvm_fresh_temp(emitter, "lit_tmp")
    var updated = curOut + "    " + tmp + " = alloca %SylvelVal, align 8\n"
    if vStr == "true" {
        updated = updated + "    call void @sylvel_rt_make_bool(%SylvelVal* " + tmp + ", i32 1)\n"
    } else if vStr == "false" {
        updated = updated + "    call void @sylvel_rt_make_bool(%SylvelVal* " + tmp + ", i32 0)\n"
    } else if is_digit(stringSub(vStr, 0, 1)) {
        updated = updated + "    call void @sylvel_rt_make_int(%SylvelVal* " + tmp + ", i64 " + vStr + ")\n"
    } else {
        updated = updated + "    call void @sylvel_rt_make_null(%SylvelVal* " + tmp + ")\n"
    }
    return { "ptr": tmp, "out": updated }
}

def llvm_emit_function(emitter, func) {
    let funcName = func["name"]
    var out = ""

    if funcName == "main" {
        out = out + "define i32 @main(i32 %argc, i8** %argv) {\n"
    } else {
        out = out + "define void @" + funcName + "(%SylvelVal* %out"
        for p in func["params"] {
            out = out + ", %SylvelVal* %" + p
        }
        out = out + ") {\n"
    }
    out = out + "bb_entry:\n"    # Hoist all alloca stack slots to the entry of the function
    var declaredSlots = {}
    for bb in func["blocks"] {
        for inst in bb["insts"] {
            let kind = inst["kind"]
            var dest = ""
            if kind == QIL_INST_ALLOC or kind == QIL_INST_LOAD or kind == QIL_INST_RUNTIME_CALL or kind == QIL_INST_BINOP or kind == QIL_INST_UNARYOP or kind == QIL_INST_CALL {
                dest = inst["dest"]
            }
            if dest != "" and not mapHas(declaredSlots, dest) {
                mapSet(declaredSlots, dest, true)
                out = out + "    %" + dest + " = alloca %SylvelVal, align 8\n"
                out = out + "    call void @sylvel_rt_make_null(%SylvelVal* %" + dest + ")\n"
            }
        }
    }

    for bb in func["blocks"] {
        if bb["label"] != "entry" {
            out = out + "bb_" + bb["label"] + ":\n"
        }
        var hasTerm = false

        for inst in bb["insts"] {
            if not hasTerm {
                let kind = inst["kind"]
                if kind == QIL_INST_ALLOC {
                    # Already hoisted to entry
                }
                else if kind == QIL_INST_STORE {
                    let dest = inst["dest"]
                    let src = toString(inst["src"])
                    if stringStartsWith(src, "%") {
                        let tmpLoad = llvm_fresh_temp(emitter, "tmp_load")
                        out = out + "    " + tmpLoad + " = load %SylvelVal, %SylvelVal* " + src + ", align 8\n"
                        out = out + "    store %SylvelVal " + tmpLoad + ", %SylvelVal* %" + dest + ", align 8\n"
                    } else if is_digit(stringSub(src, 0, 1)) {
                        out = out + "    call void @sylvel_rt_make_int(%SylvelVal* %" + dest + ", i64 " + src + ")\n"
                    } else {
                        out = out + "    call void @sylvel_rt_make_null(%SylvelVal* %" + dest + ")\n"
                    }
                }
                else if kind == QIL_INST_LOAD {
                    let dest = inst["dest"]
                    let src = inst["src"]
                    let tmpVal = llvm_fresh_temp(emitter, "t_val")
                    out = out + "    " + tmpVal + " = load %SylvelVal, %SylvelVal* %" + src + ", align 8\n"
                    out = out + "    store %SylvelVal " + tmpVal + ", %SylvelVal* %" + dest + ", align 8\n"
                }
                else if kind == QIL_INST_RUNTIME_CALL {
                    let dest = inst["dest"]
                    let rtName = inst["rtName"]
                    let args = inst["args"]

                    if rtName == "sylvel_rt_make_int" and arrayLen(args) > 0 {
                        out = out + "    call void @sylvel_rt_make_int(%SylvelVal* %" + dest + ", i64 " + toString(args[0]) + ")\n"
                    } else if rtName == "sylvel_rt_make_float" and arrayLen(args) > 0 {
                        out = out + "    call void @sylvel_rt_make_float(%SylvelVal* %" + dest + ", double " + toString(args[0]) + ")\n"
                    } else if rtName == "sylvel_rt_make_bool" and arrayLen(args) > 0 {
                        out = out + "    call void @sylvel_rt_make_bool(%SylvelVal* %" + dest + ", i32 " + toString(args[0]) + ")\n"
                    } else if rtName == "sylvel_rt_make_null" {
                        out = out + "    call void @sylvel_rt_make_null(%SylvelVal* %" + dest + ")\n"
                    } else if rtName == "sylvel_rt_alloc_string" and arrayLen(args) > 0 {
                        var rawStr = toString(args[0])
                        if stringStartsWith(rawStr, "\"") and stringEndsWith(rawStr, "\"") and stringLen(rawStr) >= 2 {
                            rawStr = stringSub(rawStr, 1, stringLen(rawStr) - 2)
                        }
                        let strSym = llvm_intern_string(emitter, rawStr)
                        let strLen = stringLen(rawStr) + 1
                        out = out + "    call void @sylvel_rt_alloc_string(%SylvelVal* %" + dest + ", i8* getelementptr inbounds ([" + toString(strLen) + " x i8], [" + toString(strLen) + " x i8]* " + strSym + ", i32 0, i32 0))\n"
                    } else if rtName == "sylvel_rt_alloc_list" {
                        var cap = "8"
                        if arrayLen(args) > 0 { cap = toString(args[0]) }
                        out = out + "    call void @sylvel_rt_alloc_list(%SylvelVal* %" + dest + ", i64 " + cap + ")\n"
                    } else if rtName == "sylvel_rt_alloc_map" {
                        var cap = "8"
                        if arrayLen(args) > 0 { cap = toString(args[0]) }
                        out = out + "    call void @sylvel_rt_alloc_map(%SylvelVal* %" + dest + ", i64 " + cap + ")\n"
                    } else if rtName == "sylvel_rt_list_push" and arrayLen(args) >= 2 {
                        let listPtr = llvm_ensure_val_ptr(emitter, args[0], out)
                        out = listPtr["out"]
                        let itemPtr = llvm_ensure_val_ptr(emitter, args[1], out)
                        out = itemPtr["out"]
                        out = out + "    call void @sylvel_rt_list_push(%SylvelVal* " + listPtr["ptr"] + ", %SylvelVal* " + itemPtr["ptr"] + ")\n"
                    } else if rtName == "sylvel_rt_map_set" and arrayLen(args) >= 3 {
                        let mapPtr = llvm_ensure_val_ptr(emitter, args[0], out)
                        out = mapPtr["out"]
                        let keyPtr = llvm_ensure_val_ptr(emitter, args[1], out)
                        out = keyPtr["out"]
                        let valPtr = llvm_ensure_val_ptr(emitter, args[2], out)
                        out = valPtr["out"]
                        out = out + "    call void @sylvel_rt_map_set(%SylvelVal* " + mapPtr["ptr"] + ", %SylvelVal* " + keyPtr["ptr"] + ", %SylvelVal* " + valPtr["ptr"] + ")\n"
                    } else if rtName == "sylvel_rt_subscript_get" and arrayLen(args) >= 2 {
                        let tgtPtr = llvm_ensure_val_ptr(emitter, args[0], out)
                        out = tgtPtr["out"]
                        let idxPtr = llvm_ensure_val_ptr(emitter, args[1], out)
                        out = idxPtr["out"]
                        out = out + "    call void @sylvel_rt_subscript_get(%SylvelVal* %" + dest + ", %SylvelVal* " + tgtPtr["ptr"] + ", %SylvelVal* " + idxPtr["ptr"] + ")\n"
                    } else if rtName == "sylvel_rt_subscript_set" and arrayLen(args) >= 3 {
                        let tgtPtr = llvm_ensure_val_ptr(emitter, args[0], out)
                        out = tgtPtr["out"]
                        let idxPtr = llvm_ensure_val_ptr(emitter, args[1], out)
                        out = idxPtr["out"]
                        let valPtr = llvm_ensure_val_ptr(emitter, args[2], out)
                        out = valPtr["out"]
                        out = out + "    call void @sylvel_rt_subscript_set(%SylvelVal* " + tgtPtr["ptr"] + ", %SylvelVal* " + idxPtr["ptr"] + ", %SylvelVal* " + valPtr["ptr"] + ")\n"
                    }
                }
                else if kind == QIL_INST_BINOP {
                    let dest = inst["dest"]
                    var left = toString(inst["left"])
                    var right = toString(inst["right"])
                    let op = inst["op"]

                    var opCode = 1
                    if op == "+"  { opCode = 1 }
                    else if op == "-"  { opCode = 2 }
                    else if op == "*"  { opCode = 3 }
                    else if op == "/"  { opCode = 4 }
                    else if op == "%"  { opCode = 5 }
                    else if op == "==" { opCode = 6 }
                    else if op == "!=" { opCode = 7 }
                    else if op == "<"  { opCode = 8 }
                    else if op == "<=" { opCode = 9 }
                    else if op == ">"  { opCode = 10 }
                    else if op == ">=" { opCode = 11 }
                    else if op == "&"  { opCode = 12 }
                    else if op == "|"  { opCode = 13 }
                    else if op == "^"  { opCode = 14 }
                    else if op == "<<" { opCode = 15 }
                    else if op == ">>" { opCode = 16 }
                    else if op == "and" or op == "&&" { opCode = 17 }
                    else if op == "or"  or op == "||" { opCode = 18 }
                    else if op == "//" { opCode = 19 }

                    let leftPtr = llvm_ensure_val_ptr(emitter, left, out)
                    out = leftPtr["out"]
                    let rightPtr = llvm_ensure_val_ptr(emitter, right, out)
                    out = rightPtr["out"]

                    out = out + "    call void @sylvel_rt_bin_op(%SylvelVal* %" + dest + ", %SylvelVal* " + leftPtr["ptr"] + ", i32 " + toString(opCode) + ", %SylvelVal* " + rightPtr["ptr"] + ")\n"
                }
                else if kind == QIL_INST_UNARYOP {
                    let dest = inst["dest"]
                    var operand = toString(inst["operand"])
                    let op = inst["op"]

                    var opCode = 2
                    if op == "-" or op == "neg" { opCode = 2 }
                    else if op == "not" or op == "!" { opCode = 20 }
                    else if op == "~" { opCode = 21 }

                    let opndPtr = llvm_ensure_val_ptr(emitter, operand, out)
                    out = opndPtr["out"]

                    out = out + "    call void @sylvel_rt_unary_op(%SylvelVal* %" + dest + ", i32 " + toString(opCode) + ", %SylvelVal* " + opndPtr["ptr"] + ")\n"
                }
                else if kind == QIL_INST_CALL {
                    let dest = inst["dest"]
                    var funcName = inst["funcName"]
                    let args = inst["args"]

                    if funcName == "print" {
                        var argVal = "%" + dest
                        if arrayLen(args) > 0 {
                            let argPtr = llvm_ensure_val_ptr(emitter, args[0], out)
                            out = argPtr["out"]
                            argVal = argPtr["ptr"]
                        }
                        out = out + "    call void @sylvel_rt_print(%SylvelVal* " + argVal + ")\n"
                    } else {
                        if is_runtime_builtin(funcName) {
                            funcName = "sylvel_rt_builtin_" + funcName
                            mapSet(emitter["usedBuiltins"], funcName, arrayLen(args))
                        }

                        var callStr = "    call void @" + funcName + "(%SylvelVal* %" + dest
                        for a in args {
                            let aPtr = llvm_ensure_val_ptr(emitter, a, out)
                            out = aPtr["out"]
                            callStr = callStr + ", %SylvelVal* " + aPtr["ptr"]
                        }
                        callStr = callStr + ")\n"
                        out = out + callStr
                    }
                }
                else if kind == QIL_INST_BRANCH {
                    out = out + "    br label %bb_" + inst["target"] + "\n"
                    hasTerm = true
                }
                else if kind == QIL_INST_COND_BRANCH {
                    let condPtr = llvm_ensure_val_ptr(emitter, inst["cond"], out)
                    out = condPtr["out"]
                    let condBoolTemp = llvm_fresh_temp(emitter, "cond_bool")
                    out = out + "    " + condBoolTemp + " = call i1 @sylvel_rt_to_bool(%SylvelVal* " + condPtr["ptr"] + ")\n"
                    out = out + "    br i1 " + condBoolTemp + ", label %bb_" + inst["then"] + ", label %bb_" + inst["else"] + "\n"
                    hasTerm = true
                }
                else if kind == QIL_INST_RETURN {
                    let retVal = toString(inst["val"])
                    if funcName == "main" {
                        out = out + "    ret i32 0\n"
                    } else {
                        if stringStartsWith(retVal, "%") {
                            let retTmp = llvm_fresh_temp(emitter, "ret_val")
                            out = out + "    " + retTmp + " = load %SylvelVal, %SylvelVal* " + retVal + ", align 8\n"
                            out = out + "    store %SylvelVal " + retTmp + ", %SylvelVal* %out, align 8\n"
                        } else if retVal == "true" {
                            out = out + "    call void @sylvel_rt_make_bool(%SylvelVal* %out, i32 1)\n"
                        } else if retVal == "false" {
                            out = out + "    call void @sylvel_rt_make_bool(%SylvelVal* %out, i32 0)\n"
                        } else if is_digit(stringSub(retVal, 0, 1)) {
                            out = out + "    call void @sylvel_rt_make_int(%SylvelVal* %out, i64 " + retVal + ")\n"
                        } else {
                            out = out + "    call void @sylvel_rt_make_null(%SylvelVal* %out)\n"
                        }
                        out = out + "    ret void\n"
                    }
                    hasTerm = true
                }
            }
        }

        if not hasTerm {
            if funcName == "main" {
                out = out + "    ret i32 0\n"
            } else {
                out = out + "    ret void\n"
            }
        }
    }

    out = out + "}\n"
    return out
}
