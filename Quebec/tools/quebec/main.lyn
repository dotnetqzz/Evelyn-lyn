# Quebec Compiler (Evelyn) — tools/quebec/main.lyn
# Self-Hosted Native Compiler CLI Driver

import "sys"
import "../../lib/Frontend/CompilerInstance.lyn"

def print_usage() {
    print("Quebec Compiler (Evelyn) v3.0.0 (Self-Hosted Native)")
    print("USAGE:")
    print("  quebec compile <file.lyn> -o <out_bin> [-O0|-O1|-O2|-O3]")
    print("  quebec emit-llvm <file.lyn> [-o <out.ll>]")
    print("  quebec emit-qil <file.lyn> [-o <out.qil>]")
    print("  quebec emit-ast <file.lyn>")
    print("  quebec check <file.lyn>")
    print("  quebec --version")
    print("  quebec --help")
}

def run_cli() {
    let args = sysArgv()
    let argCount = arrayLen(args)

    if argCount < 2 {
        print_usage()
        return
    }

    let cmd = args[1]

    if cmd == "--version" or cmd == "-v" {
        print("quebec 3.0.0 (Self-Hosted Native Compiler for Evelyn Language)")
        return
    }

    if cmd == "--help" or cmd == "-h" {
        print_usage()
        return
    }

    var inputPath = ""
    var outputPath = ""
    var mode = "compile"
    var optLevel = 2

    if cmd == "compile" {
        mode = "compile"
        if argCount >= 3 { inputPath = args[2] }
    } else if cmd == "emit-llvm" {
        mode = "emit-llvm"
        if argCount >= 3 { inputPath = args[2] }
    } else if cmd == "emit-qil" {
        mode = "emit-qil"
        if argCount >= 3 { inputPath = args[2] }
    } else if cmd == "emit-ast" {
        mode = "emit-ast"
        if argCount >= 3 { inputPath = args[2] }
    } else if cmd == "check" {
        mode = "check"
        if argCount >= 3 { inputPath = args[2] }
    } else {
        inputPath = cmd
        mode = "compile"
    }

    # Parse remaining flags (-o, -O0..3)
    var i = 2
    while i < argCount {
        let arg = args[i]
        if arg == "-o" and (i + 1) < argCount {
            outputPath = args[i + 1]
            i = i + 1
        } else if arg == "-O0" {
            optLevel = 0
        } else if arg == "-O1" {
            optLevel = 1
        } else if arg == "-O2" {
            optLevel = 2
        } else if arg == "-O3" {
            optLevel = 3
        }
        i = i + 1
    }

    if stringLen(inputPath) == 0 {
        print("Error: No input file specified.")
        print_usage()
        return
    }

    if stringLen(outputPath) == 0 and mode == "compile" {
        outputPath = "a.exe"
    }

    print("Quebec CLI: mode=" + mode + " input=" + inputPath + " output=" + outputPath)
    let ci = compiler_instance_new({})
    compiler_compile_file(ci, inputPath, outputPath, mode, optLevel)
}

run_cli()
